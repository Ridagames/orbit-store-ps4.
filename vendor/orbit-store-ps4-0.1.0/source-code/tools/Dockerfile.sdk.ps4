# PS4 payload SDK v0.9 with guarded firmware 13.52, 14.00 and 14.02 support.
#
# Upstream added 13.52 and 14.00 to the SDK's crt (kernel.c, patch.c) and to elfldr in
# September 2026. A narrowly guarded 14.02 kernel-init patch is then applied from
# tools/patch_sdk_1402.py, using offsets checked against retail FW 14.02. This first stage builds
# both from pinned commits the way upstream CI does: Ubuntu 24.04, clang 18.1.3, the same
# paths, and elfldr's commit time as its build date. It first rebuilds SDK v0.9's crt1.o and
# elfldr v0.7 from their release commits and stops unless both match the official files byte
# for byte, so the newer files are what upstream's own build produces.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 AS upstream
RUN apt-get update && apt-get install -y --no-install-recommends clang-18=1:18.1.3-1ubuntu1 lld-18=1:18.1.3-1ubuntu1 llvm-18=1:18.1.3-1ubuntu1 make xxd unzip curl ca-certificates python3 && rm -rf /var/lib/apt/lists/*
ARG SDK_ZIP_SHA256=3190e88255a72161e5ce2f22a8ae8f638a2c5a9d1ff1e0209ed692d36b4d9ec5
ARG SDK_RELEASE_COMMIT=1a85cb5a8ea12dc2dcfbcc878700d0d097245de7
ARG SDK_RELEASE_SOURCE_SHA256=f1aadc552d49d8eb019ed728e9a6cce347ace485325f9cc31e207d5c39f940cb
ARG SDK_COMMIT=573b4a0d0d5fa8695cfeee5f5e2f0447c550035d
ARG SDK_SOURCE_SHA256=9551320c52409de3bd15acc8cb8807591813748409ae4e7bac7a69b0e7288c4d
ARG ELFLDR_RELEASE_COMMIT=b3ee49746cb9f3464e8dc75ec6387e8408558b8a
ARG ELFLDR_RELEASE_SOURCE_SHA256=f27144fb4bb158b38b2e603160c5254ae83a0285f1d59e5e9e5d04a52842ee67
ARG ELFLDR_RELEASE_SHA256=cc08f39eee46f9c27d778486f7028f05605bd63e758640f83cd595ed270f54e4
ARG ELFLDR_RELEASE_DATE_EPOCH=1778609524
ARG ELFLDR_COMMIT=a4817404f5cb2d5c177b05cd5e4548b74e6c2725
ARG ELFLDR_SOURCE_SHA256=9d351ad25c57bc63f15d0a3ecbd9b7e5c45317d08e593d61d56a71dbb003c81c
ARG ELFLDR_DATE_EPOCH=1790242782
ENV PS4_PAYLOAD_SDK=/opt/hostedtoolcache/ps4-payload-sdk
COPY tools/patch_sdk_1402.py /tmp/patch_sdk_1402.py
RUN set -e; \
    fetch() { curl --fail --location --retry 3 "$1" -o "$2" && echo "$3  $2" | sha256sum -c -; }; \
    unpack() { mkdir -p "$2" && tar -xzf "$1" -C "$2" --strip-components=1; }; \
    fetch https://github.com/ps4-payload-dev/sdk/releases/download/v0.9/ps4-payload-sdk.zip /tmp/sdk.zip "$SDK_ZIP_SHA256"; \
    mkdir -p /opt/hostedtoolcache && unzip -q /tmp/sdk.zip -d /opt/hostedtoolcache; \
    fetch "https://codeload.github.com/ps4-payload-dev/sdk/tar.gz/$SDK_RELEASE_COMMIT" /tmp/sdk-release.tar.gz "$SDK_RELEASE_SOURCE_SHA256"; \
    fetch "https://codeload.github.com/ps4-payload-dev/sdk/tar.gz/$SDK_COMMIT" /tmp/sdk-source.tar.gz "$SDK_SOURCE_SHA256"; \
    fetch "https://codeload.github.com/ps4-payload-dev/elfldr/tar.gz/$ELFLDR_RELEASE_COMMIT" /tmp/elfldr-release.tar.gz "$ELFLDR_RELEASE_SOURCE_SHA256"; \
    fetch "https://codeload.github.com/ps4-payload-dev/elfldr/tar.gz/$ELFLDR_COMMIT" /tmp/elfldr-source.tar.gz "$ELFLDR_SOURCE_SHA256"; \
    unpack /tmp/sdk-release.tar.gz /src/sdk-release; \
    make -s -C /src/sdk-release/crt LLVM_CONFIG=/usr/bin/llvm-config-18; \
    cmp /src/sdk-release/crt/crt1.o "$PS4_PAYLOAD_SDK/target/lib/crt1.o"; \
    work=/home/runner/work/elfldr/elfldr; \
    unpack /tmp/elfldr-release.tar.gz "$work"; \
    SOURCE_DATE_EPOCH="$ELFLDR_RELEASE_DATE_EPOCH" make -s -C "$work" all; \
    echo "$ELFLDR_RELEASE_SHA256  $work/elfldr.elf" | sha256sum -c -; \
    mv "$work" /src/elfldr-release; \
    unpack /tmp/sdk-source.tar.gz /src/sdk; \
    python3 /tmp/patch_sdk_1402.py /src/sdk/crt/kernel.c; \
    make -s -C /src/sdk/crt LLVM_CONFIG=/usr/bin/llvm-config-18; \
    install -m 644 /src/sdk/crt/crt1.o "$PS4_PAYLOAD_SDK/target/lib/crt1.o"; \
    unpack /tmp/elfldr-source.tar.gz "$work"; \
    SOURCE_DATE_EPOCH="$ELFLDR_DATE_EPOCH" make -s -C "$work" all; \
    mkdir -p /opt/elfldr && cp "$work/elfldr.elf" "$work/elfldr.bin" /opt/elfldr/; \
    sha256sum "$PS4_PAYLOAD_SDK/target/lib/crt1.o" /opt/elfldr/elfldr.elf /opt/elfldr/elfldr.bin

FROM debian:trixie
RUN apt-get update && apt-get install -y --no-install-recommends bash clang-19 lld-19 llvm-19 make ca-certificates curl unzip && rm -rf /var/lib/apt/lists/*
COPY --from=upstream /opt/hostedtoolcache/ps4-payload-sdk /opt/ps4-payload-sdk
# elfldr built above; tools/bootstrap.py copies it to .deps/elfldr/ and checks its SHA-256.
COPY --from=upstream /opt/elfldr /opt/elfldr
ENV PS4_PAYLOAD_SDK=/opt/ps4-payload-sdk
ENV LLVM_CONFIG=/usr/bin/llvm-config-19
WORKDIR /work
ENTRYPOINT ["make"]
